rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == 'tobionlyn@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /system/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      // Anyone (anonymous readers or logged-in users) can subscribe to the Daily Briefing
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() >= 4
        && request.resource.data.email.size() <= 256
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.subscribedAt is string;
      // Only admins can view the subscriber database (protects subscriber PII)
      allow read: if isAdmin();
      // Admins can manage any record; signed-in users can update/delete their own record
      allow update, delete: if isAdmin() || (signedIn() && (resource.data.uid == request.auth.uid || subscriberId == request.auth.uid));
    }

    match /members/{memberId} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow write: if isAdmin();
    }

    match /registered_users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      // A signed-in user may update their OWN record (e.g. lastLogin,
      // loginCount on repeat sign-ins) in addition to admin management.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /analytics_visits/{visitId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /bookmarks/{bookmarkId} {
      allow read: if signedIn() && request.auth.uid == resource.data.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.uid);
    }

    match /ai_conversations/{convId} {
      allow read, update, delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Community (user-posted blog/board) -------------------------------

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.type in ['text', 'image', 'video', 'link'];
      // The author can edit their own post's content; ANY signed-in user can
      // update a post but ONLY to toggle their own like (so liking someone
      // else's post doesn't require giving them edit rights to its content);
      // admins can do either.
      allow update: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy']));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Public profile info (username, display name, bio) — separate from
    // `registered_users` above, which is private account/login bookkeeping.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // One doc per claimed username (lowercased), used purely to enforce
    // uniqueness — see utils/community.ts `claimUsername`, which creates
    // this and the matching /profiles/{uid} doc together in one transaction.
    // Immutable once created so usernames can't be reassigned/stolen.
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
