rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'yussufelijah@gmail.com' ||
        request.auth.token.email.matches('(?i)yussufelijah@gmail\\.com')
      );
    }

    // Stories: Publicly readable by all visitors; writable only by site owner admin
    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isOwnerAdmin();
    }

    // Subscribers: Anyone can join the newsletter; list read only by site owner admin
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, delete: if isOwnerAdmin();
      allow update: if isOwnerAdmin();
    }

    // User Bookmarks: Authenticated users can manage their own saved articles
    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // AI Conversations: Authenticated users can manage their own conversation threads
    match /ai_conversations/{convId} {
      allow read, write: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }
  }
}
