# Gemini API Key for server-side AI endpoints
GEMINI_API_KEY=

# Server configuration
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Firebase credentials (managed via firebase-applet-config.json)
FIREBASE_API_KEY=

# Email configuration (SMTP / SendGrid compatible service)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Viralhoods <noreply@viralhoods.example>"
ADMIN_API_KEY=
