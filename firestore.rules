rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Chief Administrator verification - Strictly tobionlyn@gmail.com only
    function isChiefAdmin() {
      return isSignedIn() && request.auth.token.email == 'tobionlyn@gmail.com';
    }

    // Administrator check - Exclusively the Chief Administrator
    function isAdmin() {
      return isChiefAdmin();
    }

    // Stories: Publicly readable; editable by editorial sessions
    match /stories/{storyId} {
      allow read: if true;
      allow write: if true;
    }

    // System status & scraper bot execution metadata
    match /system/{docId} {
      allow read, write: if true;
    }

    // Subscribers: Anyone can join the newsletter
    match /subscribers/{subscriberId} {
      allow create, read, update, delete: if true;
    }

    // Member Profiles
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Registered Users Database (Drops all registrations and logins for Chief Admin access)
    match /registered_users/{userId} {
      allow create, update: if true;
      allow read: if true;
      allow delete: if isChiefAdmin();
    }

    // User Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    // AI Conversations
    match /ai_conversations/{convId} {
      allow read, write: if true;
    }

    // Appointed Administrators:
    // Only the Chief Administrator has authority to appoint or revoke administrator credentials!
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Website Visitor Telemetry & Page Tracking:
    match /analytics_visits/{visitId} {
      allow read, write: if true;
    }
  }
}
