rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /system/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow write: if isAdmin();
    }

    match /registered_users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    match /analytics_visits/{visitId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /bookmarks/{bookmarkId} {
      allow read: if signedIn() && request.auth.uid == resource.data.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.uid);
    }

    match /ai_conversations/{convId} {
      allow read, update, delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
