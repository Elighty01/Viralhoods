{
  "entities": {
    "Story": {
      "title": "Story",
      "description": "An original news story synthesized by Viralhoods",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "author": { "type": "string" },
        "readTime": { "type": "string" },
        "date": { "type": "string" },
        "image": { "type": "string" },
        "keyTakeaways": { "type": "array" },
        "content": { "type": "array" },
        "whyItMatters": { "type": "string" },
        "whatNext": { "type": "string" },
        "createdById": { "type": "string" }
      },
      "required": ["id", "category", "title", "summary", "date"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "A reader subscribed to the Viralhoods Daily Briefing",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "subscribedAt": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["email", "subscribedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "A saved story bookmark for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "storyId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "storyId"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "An interactive AI chat conversation thread",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "updatedAt": { "type": "string" },
        "messages": { "type": "array" }
      },
      "required": ["userId", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Appointed administrator role with Chief Administrator stealth control",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedBy": { "type": "string" },
        "addedAt": { "type": "string" },
        "role": { "type": "string" },
        "isChief": { "type": "boolean" },
        "invisibleToStaff": { "type": "boolean" }
      },
      "required": ["email", "addedAt"]
    },
    "Member": {
      "title": "Member",
      "description": "Registered member profile",
      "type": "object",
      "properties": {
        "identifier": { "type": "string" },
        "lastActive": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["identifier"]
    },
    "VisitEvent": {
      "title": "VisitEvent",
      "description": "Anonymous reader visitor session and pageview tracking event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "page": { "type": "string" },
        "path": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "countryCode": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "timestamp": { "type": "string" }
      },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "User registration and login telemetry record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "registeredAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "loginCount": { "type": "number" },
        "isAdmin": { "type": "boolean" },
        "source": { "type": "string" }
      },
      "required": ["email", "lastLogin"]
    },
    "Post": {
      "title": "Post",
      "description": "Community board user post",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["authorUid", "title", "type"]
    },
    "Report": {
      "title": "Report",
      "description": "Flagged post report",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["postId", "reportedBy"]
    }
  },
  "firestore": {
    "/stories/{storyId}": {
      "schema": { "$ref": "entities/Story" },
      "description": "Publicly readable news stories published on Viralhoods"
    },
    "/subscribers/{subscriberId}": {
      "schema": { "$ref": "entities/Subscriber" },
      "description": "Newsletter subscribers collection"
    },
    "/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "entities/Bookmark" },
      "description": "User saved bookmarks"
    },
    "/ai_conversations/{convId}": {
      "schema": { "$ref": "entities/AiConversation" },
      "description": "Conversations with the AI news assistant"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "entities/Admin" },
      "description": "Appointed administrators collection"
    },
    "/members/{memberId}": {
      "schema": { "$ref": "entities/Member" },
      "description": "Registered members and profiles"
    },
    "/registered_users/{userId}": {
      "schema": { "$ref": "entities/RegisteredUser" },
      "description": "Registered member login audit records"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "entities/Post" },
      "description": "User submitted community board posts"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "entities/Report" },
      "description": "Community moderation reports"
    },
    "/analytics_visits/{visitId}": {
      "schema": { "$ref": "entities/VisitEvent" },
      "description": "Visitor traffic and pageview events with location metadata"
    }
  }
}
