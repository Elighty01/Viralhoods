rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Stories: Publicly readable by all visitors; writable by editorial sessions & automated bot
    match /stories/{storyId} {
      allow read: if true;
      allow write: if true;
    }

    // System status & bot execution metadata
    match /system/{docId} {
      allow read, write: if true;
    }

    // Subscribers: Anyone can join the newsletter
    match /subscribers/{subscriberId} {
      allow create, write: if true;
      allow read, delete, update: if true;
    }

    // Member Profiles
    match /members/{memberId} {
      allow read, write: if true;
    }

    // User Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    // AI Conversations
    match /ai_conversations/{convId} {
      allow read, write: if true;
    }
  }
}
